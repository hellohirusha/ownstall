# ─── SCALARS ─────────────────────────────────────────────────
scalar Time
scalar UUID

# ─── TYPES ───────────────────────────────────────────────────

type User {
  id: UUID!
  email: String!
  firstName: String
  lastName: String
  role: String!
  createdAt: Time!
}

type Tenant {
  id: UUID!
  name: String!
  subdomain: String!
  plan: String!
  isActive: Boolean!
  createdAt: Time!
}

type AuthPayload {
  accessToken: String!
  refreshToken: String!
  expiresIn: Int!
  user: User!
}

# ─── QUERIES ─────────────────────────────────────────────────

type Query {
  # Get the currently authenticated user
  me: User!

  # Get tenant by subdomain (for public storefront)
  tenant(subdomain: String!): Tenant

  # tenantId enables public storefront listings (forces active-only);
  # authenticated admins omit it to list their own tenant's products
  products(tenantId: UUID, status: String): [Product!]!
  product(id: ID!): Product
  productBySlug(tenantId: UUID!, slug: String!): Product

  orders(status: String): [Order!]!
  order(id: UUID!): Order

  # Notify — auth required
  emailTemplates: [EmailTemplate!]!
  emailCampaigns: [EmailCampaign!]!

  # Reply — auth required
  tickets(status: String, priority: String, search: String): [Ticket!]!
  ticket(id: UUID!): Ticket
  cannedResponses: [CannedResponse!]!
  supportMetrics: SupportMetrics!
}

# ─── MUTATIONS ───────────────────────────────────────────────

type Mutation {
  # Auth mutations — no auth required
  login(email: String!, password: String!): AuthPayload!
  signup(
    storeName: String!
    subdomain: String!
    email: String!
    password: String!
  ): AuthPayload!

  # Admin mutations — auth required
  updateProfile(firstName: String, lastName: String): User!

  createProduct(input: CreateProductInput!): Product!
  updateProduct(id: UUID!, input: UpdateProductInput!): Product!
  deleteProduct(id: UUID!): Boolean!
  publishProduct(id: UUID!): Product!
  addProductImage(
    productId: UUID!
    url: String!
    altText: String
  ): ProductImage!

  # Notify — auth required
  createCampaign(input: CreateCampaignInput!): EmailCampaign!
  # sendAt omitted = send on the scheduler's next tick
  scheduleCampaign(id: UUID!, sendAt: Time): EmailCampaign!

  # Reply — auth required
  createTicket(input: CreateTicketInput!): Ticket!
  replyToTicket(ticketId: UUID!, body: String!, isInternal: Boolean!): TicketMessage!
  updateTicketStatus(ticketId: UUID!, status: String!): Ticket!
}

# ─── PRODUCT TYPES ───────────────────────────────────────────

type Product {
  id: UUID!
  tenantId: UUID!
  name: String!
  slug: String!
  description: String
  shortDesc: String
  basePrice: Float!
  comparePrice: Float
  status: String!
  isFeatured: Boolean!
  tags: [String!]!
  images: [ProductImage!]!
  variants: [ProductVariant!]!
  createdAt: Time!
  updatedAt: Time!
}

type ProductImage {
  id: UUID!
  url: String!
  altText: String
  position: Int!
}

type ProductVariant {
  id: UUID!
  sku: String!
  title: String!
  option1Name: String
  option1Value: String
  option2Name: String
  option2Value: String
  price: Float!
  comparePrice: Float
  stockQuantity: Int!
  isInStock: Boolean!
  isActive: Boolean!
  imageUrl: String
}

input CreateProductInput {
  name: String!
  description: String
  basePrice: Float!
  comparePrice: Float
  tags: [String!]
}

input UpdateProductInput {
  name: String
  description: String
  basePrice: Float
  comparePrice: Float
  status: String
  isFeatured: Boolean
  tags: [String!]
}

# ─── NOTIFY TYPES ────────────────────────────────────────────

type EmailTemplate {
  id: UUID!
  name: String!
  slug: String!
  description: String
  subject: String!
  isSystem: Boolean!
  createdAt: Time!
}

type EmailCampaign {
  id: UUID!
  name: String!
  subject: String!
  templateId: UUID
  status: String!
  recipientType: String!
  recipientCount: Int!
  sentCount: Int!
  deliveredCount: Int!
  openedCount: Int!
  clickedCount: Int!
  scheduledAt: Time
  startedAt: Time
  completedAt: Time
  createdAt: Time!
}

input CreateCampaignInput {
  name: String!
  subject: String!
  templateId: UUID!
}

# ─── REPLY TYPES ─────────────────────────────────────────────

type Ticket {
  id: UUID!
  number: Int!
  subject: String!
  status: String!
  priority: String!
  customerEmail: String!
  customerName: String
  assigneeId: UUID
  # Empty string when unassigned
  assigneeName: String!
  source: String!
  # 'ok' | 'at_risk' | 'breached' | 'met' | 'none'
  slaStatus: String!
  slaFirstResponseAt: Time
  firstResponseAt: Time
  resolvedAt: Time
  # AI draft fields populated on Day 8
  aiDraftBody: String
  aiDraftConfidence: Float
  # Preview of the newest non-internal message (inbox list)
  latestMessage: String!
  # Customer messages since the last staff reply
  unreadCount: Int!
  messages: [TicketMessage!]!
  createdAt: Time!
  updatedAt: Time!
}

type TicketMessage {
  id: UUID!
  # 'customer' | 'staff' | 'system' | 'ai'
  authorType: String!
  authorName: String
  authorEmail: String
  body: String!
  isInternal: Boolean!
  createdAt: Time!
}

type CannedResponse {
  id: UUID!
  name: String!
  shortcut: String
  body: String!
}

type SupportMetrics {
  openTickets: Int!
  # Averages over tickets that have a first response / resolution
  avgFirstResponseHours: Float!
  avgResolutionHours: Float!
  # Fraction (0-1) of SLA-tracked tickets responded to late (or overdue now)
  slaBreachRate: Float!
  # Last 7 days, oldest first
  ticketsByDay: [TicketsByDay!]!
  ticketsByStatus: [TicketsByStatus!]!
  ticketsByPriority: [TicketsByPriority!]!
}

type TicketsByDay {
  date: String!
  count: Int!
}

type TicketsByStatus {
  status: String!
  count: Int!
}

type TicketsByPriority {
  priority: String!
  count: Int!
}

input CreateTicketInput {
  subject: String!
  body: String!
  customerEmail: String!
  customerName: String
  source: String
  priority: String
  orderId: UUID
}

type Order {
  id: UUID!
  status: String!
  total: Float!
  customerEmail: String!
  customerName: String
  items: [OrderItem!]!
  createdAt: Time!
  paidAt: Time
}

type OrderItem {
  id: UUID!
  productName: String!
  variantTitle: String!
  quantity: Int!
  unitPrice: Float!
  totalPrice: Float!
  imageUrl: String
}
