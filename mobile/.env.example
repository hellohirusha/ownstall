# Copy to .env and set to a URL your PHONE can reach.
#
# "localhost" is the phone itself, not your dev machine — leaving this unset
# is why the app loads and then fails every request on a real device.
#
#   Physical device on the same Wi-Fi : http://<your-machine-LAN-IP>:8080
#   Android emulator                   : http://10.0.2.2:8080
#   iOS simulator                      : http://localhost:8080
#   Against the deployed API           : https://ownstall.up.railway.app
#
# EXPO_PUBLIC_* is inlined into the bundle at build time — restart Metro after
# changing it (`npx expo start -c` to clear the cache).
EXPO_PUBLIC_API_URL=http://192.168.1.5:8080
